// --- Comentarios cualitativos por skill, generados a partir de lo ya calculado -----
// (no se vuelve a llamar a la IA de evaluación -- solo se resume lo que ya está en
// band_detail / ai_rubric_scores).

const CEFR_ORDER = ["A1", "A2", "B1", "B2", "C1"];

function skillCommentFromBandDetail(skillName: string, raw: number, max: number, cefr: string | null, bandDetail: any): string {
  if (!cefr) {
    return `No se pudo determinar un nivel CEFR a partir de las respuestas guardadas en ${skillName}.`;
  }
  if (bandDetail && bandDetail.perBand) {
    const inconsistent = bandDetail.pattern_inconsistent === true;
    const base = `Alcanzó nivel ${cefr} en ${skillName} (${raw}/${max} respuestas correctas).`;
    return inconsistent
      ? `${base} El patrón de respuestas mostró alguna inconsistencia entre bandas -- revisar el detalle antes de confirmar el resultado.`
      : `${base} Desempeño consistente en todas las bandas evaluadas hasta ese nivel.`;
  }
  return `Alcanzó nivel ${cefr} en ${skillName} (${raw}/${max} respuestas correctas).`;
}

function writingCommentFromRubric(promptTitle: string, rubric: any, cefr: string | null): string {
  if (!rubric) {
    return `Sin calificación disponible para "${promptTitle}".`;
  }
  if (rubric.grading_failed) {
    return `No se pudo calificar automáticamente "${promptTitle}" (falla técnica al momento de la corrección). Requiere revisión manual.`;
  }
  const overall = typeof rubric.overall_comment === "string" ? rubric.overall_comment : "";
  return overall || `Nivel estimado: ${cefr || "no determinado"}.`;
}

// --- Bloque de Speaking Assessment --------------------------------------------------
// Los 4 criterios lingüísticos oficiales de OET Speaking (0-6 cada uno).
const LINGUISTIC_LABELS: Record<string, string> = {
  intelligibility: "Intelligibility",
  fluency: "Fluency",
  appropriateness_of_language: "Appropriateness of language",
  resources_of_grammar_and_expression: "Resources of grammar and expression",
};

// Los 5 criterios de comunicación clínica oficiales de OET Speaking (0-3 cada uno).
const CLINICAL_LABELS: Record<string, string> = {
  relationship_building: "Relationship building",
  understanding_patient_perspective: "Understanding and incorporating the patient's perspective",
  providing_structure: "Providing structure",
  information_gathering: "Information gathering",
  information_giving: "Information giving",
};

// Los 17 ítems del Reading & Pronunciation Diagnostic Checklist -- acá solo se usan
// para nombrar los que salieron débiles (rating <=2) como flag; el detalle completo
// queda en la base, no se vuelca fila por fila en el PDF.
const PRONUNCIATION_LABELS: Record<string, string> = {
  unstressed_vowel_reduction: "Reducción de vocales átonas (schwa)",
  fleece_kit_contrast: "Contraste FLEECE/KIT",
  face_price_glide: "Diptongos FACE/PRICE",
  goat_mouth_choice_glide: "Diptongos GOAT/MOUTH/CHOICE",
  nurse_near_square_vowels: "Vocales NURSE/NEAR/SQUARE",
  english_r_quality: "Calidad del /r/ inglés",
  h_dropped_or_replaced: "/h/ omitida o gutural",
  b_v_distinction: "Distinción /b/-/v/ (betacismo)",
  th_voiceless_voiced: "TH sorda/sonora (/θ/, /ð/)",
  sh_ch_j_zh_distinctions: "Distinciones /ʃ/, /tʃ/, /dʒ/, /ʒ/",
  initial_s_clusters: "Grupos consonánticos iniciales /s/",
  past_tense_ed_endings: "Terminaciones -ed de pasado",
  word_stress_cognates: "Acentuación en cognados",
  sentence_rhythm: "Ritmo de la oración",
  linking_across_words: "Enlaces entre palabras",
  pausing_at_punctuation: "Pausas en la puntuación",
  self_correction: "Autocorrección",
};

function buildSpeakingBlock(booking: { assessment_type: string; evaluator_score: any }) {
  const score = booking.evaluator_score;

  if (!score || typeof score !== "object") {
    return {
      title: "Speaking Assessment",
      skills: [
        {
          name: booking.assessment_type === "OET" ? "OET Speaking" : "English Speaking",
          raw: null,
          max: null,
          cefr: null,
          comment: "Evaluado en vivo por Diana.",
        },
      ],
    };
  }

  if (score.type === "OET") {
    const linguistic = score.linguistic || {};
    const clinical = score.clinical_communication || {};
    const skills = [];
    for (const key of Object.keys(LINGUISTIC_LABELS)) {
      if (typeof linguistic[key] === "number") {
        skills.push({ name: LINGUISTIC_LABELS[key], raw: linguistic[key], max: 6, cefr: null, comment: "" });
      }
    }
    for (const key of Object.keys(CLINICAL_LABELS)) {
      if (typeof clinical[key] === "number") {
        skills.push({ name: CLINICAL_LABELS[key], raw: clinical[key], max: 3, cefr: null, comment: "" });
      }
    }
    skills.push({
      name: "OET Speaking — Resultado general",
      raw: null,
      max: null,
      cefr: score.overall_grade || null,
      comment: score.comment || "Evaluado en vivo por Diana.",
    });
    return { title: "OET Speaking", skills };
  }

  if (score.type === "English") {
    const checklist = score.pronunciation_checklist || {};
    const weakItems = Object.keys(PRONUNCIATION_LABELS)
      .filter((key) => typeof checklist[key] === "number" && checklist[key] <= 2)
      .map((key) => PRONUNCIATION_LABELS[key]);
    return {
      title: "Speaking Assessment",
      skills: [
        {
          name: "English Speaking",
          raw: null,
          max: null,
          cefr: score.cefr_sublevel || score.cefr_estimate || null,
          comment: score.comment || "Evaluado en vivo por Diana.",
          flag: weakItems.length
            ? `Puntos de pronunciación a reforzar: ${weakItems.join(", ")}.`
            : (score.pronunciation_notes || null),
        },
      ],
    };
  }

  // Formato desconocido/legado -- fallback conservador (compatibilidad hacia atrás).
  return {
    title: "Speaking Assessment",
    skills: [
      {
        name: booking.assessment_type === "OET" ? "OET Speaking" : "English Speaking",
        raw: null,
        max: null,
        cefr: score.cefr_estimate || null,
        comment: score.comment || "Evaluado en vivo por Diana.",
      },
    ],
  };
}

// --- PDFShift --------------------------------------------------------------------

async function htmlToPdf(html: string): Promise<Uint8Array> {
  const apiKey = Deno.env.get("PDFSHIFT_API_KEY");
  if (!apiKey) {
    throw new Error("Falta el secret PDFSHIFT_API_KEY en Supabase.");
  }
  const res = await fetch("https://api.pdfshift.io/v3/convert/pdf", {
    method: "POST",
    headers: {
      "Authorization": `Basic ${btoa(`api:${apiKey}`)}`,
      "Content-Type": "application/json",
    },
    body: JSON.stringify({
      source: html,
      landscape: false,
      use_print: false,
    }),
  });
  if (!res.ok) {
    const errText = await res.text();
    throw new Error(`PDFShift respondió ${res.status}: ${errText.slice(0, 500)}`);
  }
  const buf = await res.arrayBuffer();
  return new Uint8Array(buf);
}

function bytesToBase64(bytes: Uint8Array): string {
  let binary = "";
  const chunkSize = 0x8000;
  for (let i = 0; i < bytes.length; i += chunkSize) {
    binary += String.fromCharCode(...bytes.subarray(i, i + chunkSize));
  }
  return btoa(binary);
}

// --- Resend (con adjunto) ---------------------------------------------------------

async function sendReportEmail(params: {
  studentName: string;
  assessmentLabel: string;
  pdfBytes: Uint8Array;
  fileName: string;
}) {
  const apiKey = Deno.env.get("RESEND_API_KEY");
  if (!apiKey) {
    throw new Error("Falta el secret RESEND_API_KEY en Supabase.");
  }
  const res = await fetch("https://api.resend.com/emails", {
    method: "POST",
    headers: {
      "Authorization": `Bearer ${apiKey}`,
      "Content-Type": "application/json",
    },
    body: JSON.stringify({
      from: NOTIFY_FROM,
      to: [NOTIFY_EMAIL],
      subject: `Reporte de resultados: ${params.studentName} (${params.assessmentLabel})`,
      text: `Adjunto el reporte de resultados de ${params.studentName} (${params.assessmentLabel}), generado automáticamente al completar el assessment.`,
      attachments: [
        {
          filename: params.fileName,
          content: bytesToBase64(params.pdfBytes),
        },
      ],
    }),
  });
  if (!res.ok) {
    const errText = await res.text();
    throw new Error(`Resend respondió ${res.status}: ${errText.slice(0, 500)}`);
  }
}

// --- Lógica principal --------------------------------------------------------------

async function buildAndSendReport(
  supabase: ReturnType<typeof createClient>,
  attemptId: string,
): Promise<{ sent: boolean; reason?: string }> {
  // 1. Attempt + student + track + report_sent_at.
  const { data: attempt, error: attemptError } = await supabase
    .from("attempts")
    .select("id, track, status, report_sent_at, student_id")
    .eq("id", attemptId)
    .maybeSingle();

  if (attemptError || !attempt) {
    return { sent: false, reason: "attempt no encontrado" };
  }
  if (attempt.report_sent_at) {
    return { sent: false, reason: "ya se había enviado antes" };
  }

  const track = attempt.track === "NIVEL1_ONLY" ? "NIVEL1_ONLY" : "FULL_360";

  const { data: student, error: studentError } = await supabase
    .from("students")
    .select("full_name, email")
    .eq("id", attempt.student_id)
    .maybeSingle();

  if (studentError || !student) {
    return { sent: false, reason: "student no encontrado" };
  }

  // 2. unlock_state (para saber assigned_route en FULL_360).
  const { data: unlock } = await supabase
    .from("unlock_state")
    .select("assigned_route")
    .eq("attempt_id", attemptId)
    .maybeSingle();

  const assignedRoute = unlock ? unlock.assigned_route : null;

  // 3. sub_scores del attempt.
  const { data: subScores, error: subScoresError } = await supabase
    .from("sub_scores")
    .select("skill, raw_score, max_score, cefr_estimate, band_detail")
    .eq("attempt_id", attemptId);

  if (subScoresError) {
    return { sent: false, reason: "error leyendo sub_scores" };
  }
  const byskill = Object.fromEntries((subScores || []).map((s: any) => [s.skill, s]));
  const nivel1Skills = ["grammar", "listening", "writing", "reading"];
  const nivel1Complete = nivel1Skills.every((sk) => byskill[sk]);

  if (!nivel1Complete) {
    return { sent: false, reason: "Nivel 1 todavía no está completo" };
  }

  // 4. Si FULL_360, verificar módulos adicionales según assigned_route, y el
  // evaluator_score de Speaking (Diana lo carga desde admin-speaking-score.html).
  if (track === "FULL_360") {
    if (assignedRoute === "STEPS2" && !byskill["steps2_reading"]) {
      return { sent: false, reason: "STEP CK 2 todavía no está completo" };
    }
    if (assignedRoute === "OET") {
      const oetSkills = ["oet_listening", "oet_reading", "oet_writing"];
      if (!oetSkills.every((sk) => byskill[sk])) {
        return { sent: false, reason: "OET todavía no está completo" };
      }
    }
    const { data: booking } = await supabase
      .from("speaking_assessment_bookings")
      .select("evaluator_score")
      .eq("attempt_id", attemptId)
      .maybeSingle();

    if (!booking || !booking.evaluator_score) {
      return { sent: false, reason: "falta el evaluator_score de Speaking" };
    }
  }

  // 5. Armar los bloques del reporte.
  const skillLabels: Record<string, string> = {
    grammar: "Grammar",
    listening: "Listening",
    reading: "Reading",
    writing: "Writing",
    steps2_reading: "STEP CK 2",
    oet_listening: "OET Listening",
    oet_reading: "OET Reading",
    oet_writing: "OET Writing",
  };

  const { data: writingSubs } = await supabase
    .from("writing_submissions")
    .select("prompt_id, ai_rubric_scores, cefr_estimate, writing_prompts(title)")
    .eq("attempt_id", attemptId);

  const nivel1Block = {
    title: "Nivel 1",
    skills: nivel1Skills.map((sk) => {
      const row = byskill[sk];
      if (sk === "writing") {
        // Comentario por cada tarea de writing enviada, si hay más de una.
        const subs = (writingSubs || []).filter((w: any) => w);
        if (subs.length > 0) {
          const comments = subs
            .map((w: any) => {
              const title = w.writing_prompts?.title || "tarea";
              return writingCommentFromRubric(title, w.ai_rubric_scores, w.cefr_estimate);
            })
            .join(" ");
          return {
            name: skillLabels[sk],
            raw: row.raw_score,
            max: row.max_score,
            cefr: row.cefr_estimate,
            comment: comments,
          };
        }
      }
      return {
        name: skillLabels[sk],
        raw: row.raw_score,
        max: row.max_score,
        cefr: row.cefr_estimate,
        comment: skillCommentFromBandDetail(skillLabels[sk], row.raw_score, row.max_score, row.cefr_estimate, row.band_detail),
      };
    }),
  };

  const blocks = [nivel1Block];

  if (track === "FULL_360") {
    if (assignedRoute === "STEPS2") {
      const row = byskill["steps2_reading"];
      const passed = row?.band_detail?.passed === true;
      blocks.push({
        title: "STEP CK 2",
        skills: [
          {
            name: "STEP CK 2 Reading",
            raw: row.raw_score,
            max: row.max_score,
            cefr: null,
            comment: passed
              ? `Aprobó con ${row.band_detail.percent}% (umbral mínimo ${row.band_detail.threshold}%).`
              : `No alcanzó el umbral mínimo: ${row.band_detail.percent}% (se requiere ${row.band_detail.threshold}%).`,
          },
        ],
      });
    } else if (assignedRoute === "OET") {
      blocks.push({
        title: "OET",
        skills: ["oet_listening", "oet_reading", "oet_writing"].map((sk) => {
          const row = byskill[sk];
          return {
            name: skillLabels[sk],
            raw: row.raw_score,
            max: row.max_score,
            cefr: null,
            comment: `Resultado informativo: ${row.band_detail?.percent ?? Math.round((row.raw_score / row.max_score) * 100)}% de respuestas correctas.`,
          };
        }),
      });
    }

    const { data: booking } = await supabase
      .from("speaking_assessment_bookings")
      .select("assessment_type, evaluator_score")
      .eq("attempt_id", attemptId)
      .maybeSingle();

    if (booking) {
      blocks.push(buildSpeakingBlock(booking as any));
    }
  }

  // 6. Nivel CEFR general: el más bajo entre los skills de Nivel 1 (nivel de piso).
  const nivel1Cefrs = nivel1Skills.map((sk) => byskill[sk]?.cefr_estimate).filter(Boolean) as string[];
  const overallCefr = nivel1Cefrs.length
    ? nivel1Cefrs.reduce((lowest, c) => (CEFR_ORDER.indexOf(c) < CEFR_ORDER.indexOf(lowest) ? c : lowest))
    : null;
  const overallNote = "El nivel general queda determinado por la skill más baja de Nivel 1, siguiendo el criterio de nivel de piso usado en la plataforma.";

  const assessmentLabel = track === "NIVEL1_ONLY" ? "Assessment Speak Easy" : "Assessment 360";
  const logoUrl = track === "NIVEL1_ONLY" ? LOGO_GENERIC_URL : LOGO_CLEARPATH_URL;
  const reportDate = new Date().toLocaleDateString("es-AR", { day: "2-digit", month: "long", year: "numeric" });

  const html = buildReportHtml({
    studentName: student.full_name || "Estudiante",
    assessmentLabel,
    logoUrl,
    reportDate,
    overallCefr,
    overallNote,
    blocks,
  });

  // 7. HTML -> PDF -> correo.
  const pdfBytes = await htmlToPdf(html);
  const fileName = `Reporte - ${(student.full_name || "estudiante").replace(/[^a-zA-Z0-9 ]/g, "")}.pdf`;

  await sendReportEmail({
    studentName: student.full_name || "Estudiante",
    assessmentLabel,
    pdfBytes,
    fileName,
  });

  // 8. Marcar enviado.
  await supabase
    .from("attempts")
    .update({ report_sent_at: new Date().toISOString() })
    .eq("id", attemptId);

  return { sent: true };
}

Deno.serve(async (req: Request) => {
  if (req.method === "OPTIONS") {
    return new Response(null, { headers: CORS_HEADERS });
  }
  if (req.method !== "POST") {
    return json({ error: "Método no permitido." }, 405);
  }

  let body: { attempt_id?: unknown };
  try {
    body = await req.json();
  } catch {
    return json({ error: "Body inválido." }, 400);
  }

  const attemptId = typeof body.attempt_id === "string" ? body.attempt_id.trim() : "";
  const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
  if (!attemptId || !UUID_RE.test(attemptId)) {
    return json({ error: "Falta o es inválido attempt_id." }, 400);
  }

  const supabase = createClient(
    Deno.env.get("SUPABASE_URL")!,
    Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!,
  );

  try {
    const result = await buildAndSendReport(supabase, attemptId);
    return json(result);
  } catch (err) {
    console.error("generate-report: error generando/enviando reporte", err);
    return json({ error: "Error interno generando el reporte.", detail: String(err) }, 500);
  }
});
